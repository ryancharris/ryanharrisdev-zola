{%- if term -%}
  {%- set feed_title = "Posts tagged “" ~ term.name ~ "”" -%}
  {%- set feed_description = "Posts tagged " ~ term.name ~ " on " ~ config.title ~ "." -%}
{%- else -%}
  {%- set feed_title = config.title -%}
  {%- set feed_description = config.description -%}
{%- endif -%}
{%- set home_url = config.base_url ~ "/" -%}
{%- set icon_url = config.base_url ~ "/apple-touch-icon.png" -%}

{%- if term -%}
  {%- set feed_link = term.permalink -%}
{%- else -%}
  {%- set feed_link = home_url -%}
{%- endif -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ feed_title }}</title>
    <link>{{ feed_link | safe }}</link>
    <description>{{ feed_description }}</description>
    <language>{{ config.extra.locale | default(value=lang) }}</language>
    <copyright>© {{ now() | date(format="%Y") }} {{ config.author }}</copyright>
    <dc:creator>{{ config.author }}</dc:creator>
    <managingEditor>{{ config.extra.email }} ({{ config.author }})</managingEditor>
    <image>
      <url>{{ icon_url | safe }}</url>
      <title>{{ feed_title }}</title>
      <link>{{ feed_link | safe }}</link>
    </image>
    <generator>Zola</generator>
    <atom:link href="{{ feed_url | safe }}" rel="self" type="application/rss+xml"/>
    <lastBuildDate>{{ now() | date(format="%a, %d %b %Y %H:%M:%S %z") }}</lastBuildDate>
    {% for page in pages %}
    {% if page.extra.hidden is defined and page.extra.hidden %}{% continue %}{% endif %}
    {% if page.include_in_feeds is defined and not page.include_in_feeds %}{% continue %}{% endif %}
    <item>
      <title>{{ page.title }}</title>
      <link>{{ page.permalink | safe }}</link>
      <guid isPermaLink="true">{{ page.permalink | safe }}</guid>
      <pubDate>{{ page.date | date(format="%a, %d %b %Y %H:%M:%S %z") }}</pubDate>
      <author>{{ config.extra.email }} ({{ config.author }})</author>
      <dc:creator>{{ config.author }}</dc:creator>
      <description xml:base="{{ page.permalink | safe }}">{{ page.content | escape | safe }}</description>
      {% if page.taxonomies.tags is defined %}
      {% for tag in page.taxonomies.tags %}
      <category>{{ tag }}</category>
      {% endfor %}
      {% endif %}
      {% if page.extra.category is defined %}
      <category>{{ page.extra.category }}</category>
      {% endif %}
    </item>
    {% endfor %}
  </channel>
</rss>
